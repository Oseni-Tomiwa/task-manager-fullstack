NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Local development MongoDB; use a dedicated database, never production credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# Generate a fresh private value with: openssl rand -hex 32
# This placeholder deliberately fails validation; never use it as a signing key.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Exact browser origin, no trailing slash; production requires HTTPS.
CLIENT_ORIGIN=http://127.0.0.1:5173
